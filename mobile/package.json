    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "sounds": "node scripts/make-sounds.mjs",
    "release:ios": "npx -y eas-cli@27.2.0 build -p ios --profile production --auto-submit",
    "store:push": "npx -y eas-cli@27.2.0 metadata:push",
    "store:lint": "npx -y eas-cli@27.2.0 metadata:lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ]
  },
  "description": "Skepsis for iOS: learn Greek roots in 3-minute lessons. Expo app, local-first.",
